# Rust
target/
# NOTE: Cargo.lock is intentionally KEPT (not ignored) — it pins the
# exact dependency versions so every build reproduces the same app.

# Node
node_modules/
dist/

# Tauri
src-tauri/gen/
src-tauri/target/

# Windows
Thumbs.db
Desktop.ini

# Editor files
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# Build outputs (installers / binaries produced by `npm run tauri build`).
# *.msi: installer outputs only — no .msi is ever a source file here.
# *.exe is scoped to the build output paths on purpose: a source .exe
# (e.g. a bundled openvpn.exe under src-tauri/resources/ in a later
# pass) must NOT be ignored, so there is no global *.exe rule.
*.msi
src-tauri/target/release/bundle/**/*.exe
src-tauri/target/release/*.exe
!src-tauri/resources/**/*.exe
